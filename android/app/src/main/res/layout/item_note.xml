<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#666666"
        android:textSize="11sp"
        android:fontFamily="monospace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Goal tag pill — only visible when the note is scoped to a goal -->
    <TextView
        android:id="@+id/tvGoalTag"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:paddingHorizontal="8dp"
        android:gravity="center"
        android:textColor="#FF9500"
        android:textSize="10sp"
        android:background="@drawable/pill_background"
        android:visibility="gone"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/tvTimestamp"
        app:layout_constraintTop_toTopOf="@+id/tvTimestamp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTimestamp" />

    <!-- Duration badge -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#555555"
        android:textSize="11sp"
        android:fontFamily="monospace"
        app:layout_constraintEnd_toStartOf="@+id/btnDelete"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="12dp" />

    <!-- Delete button -->
    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="×"
        android:textColor="#555555"
        android:textSize="20sp"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Attachment thumbnail + count, only when the note has photos -->
    <ImageView
        android:id="@+id/ivNoteThumb"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="@drawable/input_background"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:contentDescription="Attached photo"
        app:layout_constraintTop_toBottomOf="@+id/tvTranscript"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvImageCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#666666"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/ivNoteThumb"
        app:layout_constraintTop_toTopOf="@+id/ivNoteThumb"
        app:layout_constraintBottom_toBottomOf="@+id/ivNoteThumb" />

    <!-- Transcript text -->
    <TextView
        android:id="@+id/tvTranscript"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#DDDDDD"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTimestamp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider — below the thumbnail, which collapses when absent -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1F1F1F"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/ivNoteThumb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
