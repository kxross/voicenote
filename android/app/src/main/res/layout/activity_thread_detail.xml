<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:tint="@color/text_secondary"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvThreadTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="28dp"
        android:layout_marginHorizontal="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvGoalPill"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:paddingHorizontal="8dp"
        android:gravity="center"
        android:textColor="#FF9500"
        android:textSize="10sp"
        android:background="@drawable/pill_background"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/tvThreadTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnResolve"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:text="Resolve"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:background="@drawable/pill_background"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnDeleteThread"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:text="Delete"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:background="@drawable/pill_background"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnResolve" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConvo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvGoalPill"
        app:layout_constraintBottom_toTopOf="@+id/attachStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Staged photo attachments; GONE until something is picked so an empty
         state costs no vertical space. -->
    <HorizontalScrollView
        android:id="@+id/attachStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/micBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/attachRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Bottom reply bar: attach photos, tap mic to record, tap again to stop -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/micBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_image"
            android:tint="@color/text_secondary"
            android:contentDescription="Attach photos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvMicHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="tap to reply"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/btnReplyMic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnReplyMic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/pill_background"
            android:src="@drawable/ic_frosty"
            android:contentDescription="Record a reply"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
