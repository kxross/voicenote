<?xml version="1.0" encoding="utf-8"?>
<!-- Transient inbox row: an agent turn is in flight but has no thread yet
     (threads are created lazily, only once the agent engages). Disappears when
     the turn finishes — replaced by a real thread card, or by nothing if the
     agent stayed silent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <com.voicenote.app.TypingDotsView
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvStage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="#888888"
        android:textSize="14sp" />

</LinearLayout>
