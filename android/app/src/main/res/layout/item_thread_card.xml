<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background"
        android:padding="14dp"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/unreadDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/pill_background"
            android:backgroundTint="#FF9500"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvThreadTitle"
            app:layout_constraintBottom_toBottomOf="@+id/tvThreadTitle" />

        <TextView
            android:id="@+id/tvThreadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#DDDDDD"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/unreadDot"
            app:layout_constraintEnd_toStartOf="@+id/tvThreadTime"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvThreadTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="10sp"
            android:fontFamily="monospace"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvThreadTitle"
            app:layout_constraintBottom_toBottomOf="@+id/tvThreadTitle" />

        <TextView
            android:id="@+id/tvThreadGoalTag"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:paddingHorizontal="8dp"
            android:gravity="center"
            android:textColor="#FF9500"
            android:textSize="10sp"
            android:background="@drawable/pill_background"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/unreadDot"
            app:layout_constraintTop_toBottomOf="@+id/tvThreadTitle" />

        <TextView
            android:id="@+id/tvThreadSnippet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/unreadDot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvThreadGoalTag" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
