<?xml version="1.0" encoding="utf-8"?>
<!-- A sandbox command held for approval, shown inline in the thread. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/input_background"
        android:backgroundTint="@color/accent_dim"
        android:padding="14dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvApprovalHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SANDBOX · APPROVAL NEEDED"
            android:textColor="#FFCDBE"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06" />

        <!-- Smart mode: why the System One review held this command. -->
        <TextView
            android:id="@+id/tvReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:visibility="gone" />

        <!-- Scrollable code box: grows to fit, caps height (then scrolls
             vertically), and scrolls horizontally for long lines — no ellipsis.
             Selectable so the command can be copied. -->
        <com.voicenote.app.MaxHeightScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/code_block_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="horizontal"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tvCommand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F2F2F2"
                    android:textSize="12.5sp"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.25"
                    android:textIsSelectable="true" />

            </HorizontalScrollView>

        </com.voicenote.app.MaxHeightScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnDeny"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Deny"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnApprove"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:layout_marginStart="8dp"
                android:text="Approve"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/pill_background" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
