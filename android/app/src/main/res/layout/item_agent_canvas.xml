<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/input_background"
        android:padding="14dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMsgTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Optional caption (the assistant's short reply). -->
        <TextView
            android:id="@+id/tvBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#DDDDDD"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.35"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMsgTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- The AI-generated React widget. Height is driven at runtime by the
             harness via the one-way postHeight channel. -->
        <WebView
            android:id="@+id/canvasWeb"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/tvBody"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Collapsible activity accordion (skills/tools/thinking). -->
        <LinearLayout
            android:id="@+id/activitySection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/canvasWeb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/activityHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvActivityCaret"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvActivitySummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activityBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Collapsible "Sources" sub-card (see item_agent_message.xml). -->
        <LinearLayout
            android:id="@+id/sourcesSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/activitySection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/sourcesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvSourcesCaret"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸"
                    android:textColor="#7A9CC6"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvSourcesSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7A9CC6"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourcesBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/sourcesSection"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
