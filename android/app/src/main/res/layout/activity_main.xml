<?xml version="1.0" encoding="utf-8"?>
<!-- Home ("focus and dock"): header with the Frosty mark, the record hero in
     the middle, and the app's sections in a dock at the bottom, styled like the
     rest of the app (#1A1A1A surfaces, hairlines, letterspaced labels, mono
     metadata). Every id MainActivity binds is kept; section rows are GONE until
     their section has content, exactly like the old pills. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header: brand mark + name, attach + settings on the right. -->
    <ImageView
        android:id="@+id/ivBrand"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/ic_frosty"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="@+id/btnSettings"
        app:layout_constraintBottom_toBottomOf="@+id/btnSettings"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="VOICENOTE"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="@+id/btnSettings"
        app:layout_constraintBottom_toBottomOf="@+id/btnSettings"
        app:layout_constraintStart_toEndOf="@+id/ivBrand" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_settings"
        android:tint="@color/text_secondary"
        android:contentDescription="Settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnAttach"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_image"
        android:tint="@color/text_secondary"
        android:contentDescription="Attach photos"
        app:layout_constraintTop_toTopOf="@+id/btnSettings"
        app:layout_constraintEnd_toStartOf="@+id/btnSettings" />

    <!-- Hero: attachments → waveform → status → record → duration → mode, a
         packed chain centered between the header and the dock. -->

    <HorizontalScrollView
        android:id="@+id/attachStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/btnSettings"
        app:layout_constraintBottom_toTopOf="@+id/waveformView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <LinearLayout
            android:id="@+id/attachRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <com.voicenote.app.WaveformView
        android:id="@+id/waveformView"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="56dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintTop_toBottomOf="@+id/attachStrip"
        app:layout_constraintBottom_toTopOf="@+id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status in the app's mono-label voice. setStatus() still sets its text
         and color (red for errors, etc.). -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/status_ready"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@+id/waveformView"
        app:layout_constraintBottom_toTopOf="@+id/btnRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The record ring; Frosty sits in its core while idle (RecordButton). -->
    <com.voicenote.app.RecordButton
        android:id="@+id/btnRecord"
        android:layout_width="190dp"
        android:layout_height="190dp"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        app:layout_constraintBottom_toTopOf="@+id/tvDuration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:text="0:00"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@+id/btnRecord"
        app:layout_constraintBottom_toTopOf="@+id/modeTrack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action / No action: the same sticky toggle group, drawn as the app's
         pill segmented control (track = pill surface, picked segment raised). -->
    <FrameLayout
        android:id="@+id/modeTrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="3dp"
        android:background="@drawable/pill_background"
        app:layout_constraintTop_toBottomOf="@+id/tvDuration"
        app:layout_constraintBottom_toTopOf="@+id/dock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionMode"
                style="@style/Home.Segment"
                android:text="Action" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNoActionMode"
                style="@style/Home.Segment"
                android:text="No action" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </FrameLayout>

    <!-- The dock: one row per section. Dividers only between VISIBLE rows. -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        android:background="@drawable/dock_background"
        android:showDividers="middle"
        android:divider="@drawable/dock_divider"
        app:layout_constraintTop_toBottomOf="@+id/modeTrack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnViewAssistant"
            style="@style/Home.DockRow"
            android:visibility="gone">
            <ImageView style="@style/Home.DockIcon" android:src="@drawable/ic_row_assistant" />
            <TextView style="@style/Home.DockLabel" android:text="Assistant" />
            <TextView android:id="@+id/tvAssistantMeta" style="@style/Home.DockMeta" />
            <ImageView style="@style/Home.DockChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnViewArtifacts"
            style="@style/Home.DockRow"
            android:visibility="gone">
            <ImageView style="@style/Home.DockIcon" android:src="@drawable/ic_row_document" />
            <TextView style="@style/Home.DockLabel" android:text="Artifacts" />
            <TextView android:id="@+id/tvArtifactsMeta" style="@style/Home.DockMeta" />
            <ImageView style="@style/Home.DockChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnViewLists"
            style="@style/Home.DockRow"
            android:visibility="gone">
            <ImageView style="@style/Home.DockIcon" android:src="@drawable/ic_row_list" />
            <TextView style="@style/Home.DockLabel" android:text="Lists" />
            <TextView android:id="@+id/tvListsMeta" style="@style/Home.DockMeta" />
            <ImageView style="@style/Home.DockChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnViewGoals"
            style="@style/Home.DockRow"
            android:visibility="gone">
            <ImageView style="@style/Home.DockIcon" android:src="@drawable/ic_row_goal" />
            <TextView style="@style/Home.DockLabel" android:text="Goals" />
            <TextView android:id="@+id/tvGoalsMeta" style="@style/Home.DockMeta" />
            <ImageView style="@style/Home.DockChevron" />
        </LinearLayout>

        <!-- Always visible: the entry point for creating the first schedule. -->
        <LinearLayout
            android:id="@+id/btnViewSchedules"
            style="@style/Home.DockRow">
            <ImageView style="@style/Home.DockIcon" android:src="@drawable/ic_row_schedule" />
            <TextView style="@style/Home.DockLabel" android:text="Schedules" />
            <ImageView style="@style/Home.DockChevron" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
