# agent-gateway configuration. setup/02-services.sh copies this to .env
# (if missing) and fills in generated values. Never commit .env.
# Anything left out falls back to the defaults in docker-compose.yml.

# --- Compose ---
# "vmm" brings up the sandbox daemon (code interpreter) with the gateway.
COMPOSE_PROFILES=vmm

# --- Gateway auth ---
# If set, every client (the Android app, vmm's reviewer) must send
# `Authorization: Bearer <GATEWAY_API_KEY>`. Strongly recommended unless the
# gateway is only reachable on a private network. Put the same value in the
# app's Settings → Gateway API key.
GATEWAY_API_KEY=

# --- Local models (Ollama on the host) ---
# Default model for every turn that needs vision (images, video frames).
DEFAULT_MODEL=qwen3.8:latest
OLLAMA_THINK=false
OLLAMA_MAX_CONCURRENCY=2

# --- Local fast model (vLLM, optional; setup/01-host.sh --with-vllm) ---
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=qwen3.8-27b

# --- Hosted models & web search (optional, recommended) ---
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Only for agents registered with ClaudeAgentSDKRuntime.
ANTHROPIC_API_KEY=

# --- System One (typed decisions → smart sandbox approvals) ---
# kev = self-hosted Kev (setup/01-host.sh --with-kev); jev = hosted Jev.
SYSTEMONE_PROVIDER=kev
KEV_BASE_URL=http://host.docker.internal:8009
# Must match KEV_API_KEY in ~/.config/kev/kev.env (01-host.sh writes both).
KEV_API_KEY=
JEV_BASE_URL=
JEV_API_KEY=

# --- Sandbox approvals ---
# smart  = System One screens each command; only flagged ones are held
#          (fails closed: if Kev is down, commands are held);
# manual = hold everything for approval in the app;
# auto   = run everything.
# 02-services.sh switches this to manual if Kev isn't installed.
VMM_APPROVAL_MODE=smart

# --- Misc ---
TZ=Pacific/Honolulu
